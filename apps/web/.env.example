# Copy to apps/web/.env for local development. Never commit the real file.
DATABASE_URL=postgres://draft:draft@localhost:5432/livedraft
APP_URL=http://localhost:3000

# Realtime worker (apps/realtime). REALTIME_SECRET must match apps/realtime/.dev.vars
REALTIME_URL=http://localhost:8787
REALTIME_SECRET=change-me-to-a-long-random-string

# 32 random bytes, base64. Encrypts 2FA secrets and backup credentials at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Email (invites + password resets) via Resend. Leave empty in dev: emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM=Live Draft <no-reply@example.com>

# Comma-separated emails that are always site administrators. The first account created is also an admin.
ADMIN_EMAILS=

# All users must use 2FA. Set to true only for a private, non-internet deployment.
ALLOW_2FA_OPT_OUT=false

# Self-hosted (Node) only: where backups are stored when no R2 bucket is bound.
BACKUP_DIR=./data/backups
